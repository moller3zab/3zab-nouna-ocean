rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null && request.auth.uid in [
        'EJ9SoDzXCLgHBgXglBU703ZOcXH2',
        'NJRJQyKj7JbSVBQeAYbKUOm8vcY2'
      ];
    }
    match /{document=**} {
      allow read, write: if isMember();
    }
  }
}
